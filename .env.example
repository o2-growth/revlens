# Supabase — project URL/keys (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, full-access key — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — used to generate call summaries, objections, and next steps from transcripts
OPENAI_API_KEY=your-openai-key

# Restricts signup/login to a single company email domain (e.g. "o2inc.com.br")
ALLOWED_EMAIL_DOMAIN=

# Google OAuth client — used to authenticate closers/managers and read their
# Google Meet transcripts/recordings on their behalf
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google service account (JSON, single line) — used for server-to-server calls
# to the Meet REST API / Drive API when a user-delegated token isn't available
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared secret used to verify incoming Google Meet webhook/push notifications
MEET_WEBHOOK_SECRET=

# Shared secret required to trigger background jobs (e.g. transcript polling,
# AI processing) via their HTTP endpoints
JOBS_RUN_SECRET=
